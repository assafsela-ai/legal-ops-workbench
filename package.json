{
  "name": "legal-ops-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.12.0 || >=26"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
